{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": ["api", "web", "client", "shared"],
  "scripts": {
    "dev": "concurrently -n api,web,client -c blue,green,yellow \"npm run dev --workspace=api\" \"npm run dev --workspace=web\" \"npm run dev --workspace=client\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=api",
    "lint": "npm run lint --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "format": "npm run format --workspace=client",
    "test": "npm test --workspace=client",
    "typecheck": "npm run typecheck --workspace=shared",
    "build": "npm run build --workspace=web && npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}