{
  "name": "@utpost/api",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "mongo:smoke": "node --env-file-if-exists=.env src/db/mongo-smoke.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@utpost/shared": "file:../shared",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
